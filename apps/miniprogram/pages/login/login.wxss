.login {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 60rpx 0;
}
.logo {
  width: 140rpx;
  height: 140rpx;
  line-height: 140rpx;
  text-align: center;
  background: #1f6feb;
  color: #fff;
  font-size: 64rpx;
  font-weight: 700;
  border-radius: 32rpx;
  margin-bottom: 36rpx;
}
.title { font-size: 40rpx; font-weight: 700; }
.sub { font-size: 26rpx; margin-top: 16rpx; text-align: center; line-height: 1.5; }

.wx-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 80rpx;
}
.alt {
  color: #1f6feb;
  font-size: 27rpx;
  margin-top: 40rpx;
}
.agreement {
  position: fixed;
  bottom: 60rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 22rpx;
}

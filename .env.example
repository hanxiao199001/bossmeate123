# ══════════════════════════════════════════════════════════════════════════════
# BossMate 环境变量配置模板
# ══════════════════════════════════════════════════════════════════════════════
#
# 用法: `cp .env.example .env`, 然后把「必填」的几项填上, 服务就能起来。
#
# 【本文件的排版约定】
#   已解注释的行  → 没有默认值 / 必须自己填, 或强烈建议显式写死的项
#   被 # 注释的行 → 有默认值, 注释里写的就是**代码里的默认值**; 不配 = 用这个默认值。
#                   只有想改默认行为时才解注释
#
# 【.env 放哪里】
#   只认 **monorepo 根目录** 的 .env(packages/server/src/config/env.ts 用绝对路径锁死,
#   杜绝历史上"影子 packages/server/.env 抢先命中"的鬼故事)。
#   要用别处的文件, 设 ENV_FILE_PATH=/abs/path/to/.env 覆盖。文件不存在直接 throw, 不静默兜底。
#
# 【最小可启动集合】(缺这几个 env.ts 会 process.exit(1) 或功能整体不可用)
#   DATABASE_URL / JWT_SECRET / QWEN_API_KEY(或 DEEPSEEK_API_KEY)
#   生产环境还额外强制: JWT_SECRET ≥32 位、WECHAT_VERIFY_TOKEN 不能是仓库默认值。
#
# ┌────────────────────────────────────────────────────────────────────────────┐
# │ ⚠️ 交接必改清单 —— 换手第一天就要处理的四项                                  │
# │  1. PLATFORM_ADMIN_PHONES → 换成接手公司的人的手机号                         │
# │     不配 = 没有任何账号能进 /platform/* 平台管理页 = **开不了新租户**         │
# │  2. JWT_SECRET / CREDENTIALS_KEY → 全部换新                                  │
# │     CREDENTIALS_KEY 一换, 库里已加密的第三方凭证解不开, 需重新录入            │
# │  3. WECHAT_VERIFY_TOKEN → 换随机值(生产用仓库默认值会直接 exit(1))            │
# │  4. 各家云/平台 AK、API Key → 全部轮换                                       │
# └────────────────────────────────────────────────────────────────────────────┘
#
# 【本文件不管的两处 env】
#   - 前端 apps/web: 用 Vite 的 `apps/web/.env.local`, 变量必须 VITE_ 前缀(见文件末尾)
#   - 客户端 packages/agent: 有自己的运行时变量(见文件末尾)


# ══════════════════════════════════════════════════════════════════════════════
# 1. 核心服务
# ══════════════════════════════════════════════════════════════════════════════

# 运行环境。production 会打开一批强制校验(JWT 长度/回调 token/DATABASE_URL/Embedding Key)。
# 不配 = development。pm2/Docker 里务必显式设 production, 否则那些生产护栏全部不生效。
NODE_ENV=development

# HTTP 端口 / API 路由前缀
# PORT=3000
# API_PREFIX=/api/v1

# JWT 签名密钥。**必填**。
# 生产环境 <32 位直接 exit(1); 开发环境 <32 位只 warn。换掉它 = 所有已签发 token 失效(用户需重登)。
JWT_SECRET=换成至少32位的随机串-do-not-use-this-value
# JWT_EXPIRES_IN=7d

# 第三方平台凭证(公众号 AppSecret / 抖音 token 等)在库里的加密密钥。
# 不配 = 回退用 JWT_SECRET 派生。⚠️ 一旦换值, 库里已加密的凭证全部解不开, 必须让客户重新授权/重填。
# 所以: 上线前就定好, 之后别动; 交接时若要换, 要连带安排一次凭证重录。
CREDENTIALS_KEY=换成至少32位的随机串-与JWT_SECRET不同

# CORS 白名单(逗号分隔)。PR #108 强制提醒: prod 必须含 boss-mates.com。
# 5-09 生产事故根因: .env 缺这项 → 只剩 localhost → 浏览器跨域 reject → 前端白屏。
# env.ts 的 default 已经含 boss-mates.com 兜底, 这里显式写一遍是为了换域名时有地方改。
# ALLOWED_ORIGINS=https://boss-mates.com,https://api.boss-mates.com,http://localhost:5173,http://localhost:3000

# 日志
# LOG_LEVEL=info          # fatal|error|warn|info|debug|trace。注意: 线上 info 看不到 logger.debug,
#                         #   有些静默失败(如爬虫抓不到)只打 debug, 排查时临时调 debug
# LOG_DIR=./logs


# ══════════════════════════════════════════════════════════════════════════════
# 2. 数据库 / 缓存 / 存储路径
# ══════════════════════════════════════════════════════════════════════════════

# PostgreSQL。**必填**。生产环境若为空或等于 postgresql://localhost 会 exit(1)。
DATABASE_URL=postgresql://bossmate:your_password@localhost:5432/bossmate
# DATABASE_POOL_SIZE=10

# Redis(BullMQ 队列 + 缓存)。不配走本机默认; Redis 连不上会影响视频/批量任务队列。
# REDIS_URL=redis://localhost:6379

# 向量库(LanceDB)落盘目录 —— 知识库/RAG 用
# LANCEDB_PATH=./data/lancedb

# 上传文件目录 + 单文件大小上限
# UPLOAD_DIR=./data/uploads
# MAX_FILE_SIZE=50mb


# ══════════════════════════════════════════════════════════════════════════════
# 3. 平台管理 / 多租户开通   ← 交接重点
# ══════════════════════════════════════════════════════════════════════════════

# 平台管理员手机号白名单(逗号分隔), 决定谁能进 /platform/* (客户开通页、租户列表等)。
# 判定方式: JWT 不带 phone, 中间件按 user_id 查 users 表拿手机号再比对本白名单。
#
# ⚠️⚠️ 不配 = 空白名单 = **谁都进不去平台管理页 = 开不了新租户**, 且前端只是不显示入口,
#      没有任何报错提示, 排查时极易误判成"功能没做"。
# ⚠️ 交接时必须换成接手公司负责人的手机号(且该手机号要在 users 表里有账号)。
PLATFORM_ADMIN_PHONES=13800000000,13900000000

# 生产自注册闸: production 下默认关闭 POST /auth/register(-company), 客户一律由平台侧开通。
# 设 true 可重新放开公开注册。dev/test 不受此闸影响(始终放行, 免得破坏本地开发)。
# ALLOW_SELF_REGISTER=false


# ══════════════════════════════════════════════════════════════════════════════
# 4. LLM / 模型路由 / 成本
# ══════════════════════════════════════════════════════════════════════════════

# 至少配一个(生产环境两个都没有会 exit(1); 开发环境降级成本地 hash 向量, 只能凑合跑通流程)。
# QWEN_API_KEY 同时被复用于: 阿里云百炼 qwen-tts 配音、声音克隆、以及下面的 DEEPSEEK_VIA=bailian
#   —— 换 key 要连带确认这几处。
QWEN_API_KEY=your-qwen-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key

# ──────────────────────────────────────────────────────────────────────────────
# deepseek 走哪个账户(7-26 新增) —— **切百炼只需要改这一个变量**
# ──────────────────────────────────────────────────────────────────────────────
# official = DeepSeek 官方账户(默认, 与改造前行为完全一致)
#            baseURL=https://api.deepseek.com/v1 , key=DEEPSEEK_API_KEY
# bailian  = 阿里云百炼(Model Studio)
#            baseURL=https://dashscope.aliyuncs.com/compatible-mode/v1 , key=QWEN_API_KEY
#
# ① 默认走 DeepSeek 官方, 不配这个变量 = 现状不变。
# ② 切百炼**必须同时切 baseURL 和 API Key** —— 百炼不认 DeepSeek 的 key, 配错必 401,
#    而 401 属客户端错误、不触发 qwen 兜底, 整条生成链路会静默产废稿(7-24 事故原型)。
#    所以这里只暴露一个开关: 设 DEEPSEEK_VIA=bailian 即可, baseURL 与 key 自动成对切换,
#    **不要手改 DEEPSEEK_BASE_URL**(手改而没对上 key, 启动期自检会报错, 生产直接拒绝启动)。
# ③ 百炼上有同名的 deepseek-v4-pro / deepseek-v4-flash, 按官方公告**与官网同价**
#    (¥3.1/¥6.2 每 1M token), 所以切过去**模型不变、生成质量零变化、单价也不变**,
#    只是换成扣阿里云百炼余额。这是 7-25 为了用掉老板充的百炼余额做的能力。
# ④ 切完自检: pnpm --filter @bossmate/server llm:check
#    (只调不计费的 /models 列表, 401=key 不配套, 404=路径写错)
# ⑤ 若百炼控制台上模型 ID 与官网不同名(如带渠道前缀), 用 DEEPSEEK_MODEL_CHAT /
#    DEEPSEEK_MODEL_REASONER 覆盖即可, 不用改代码。
# DEEPSEEK_VIA=official

# 逃生口: 显式覆盖 baseURL(百炼换域名 / 走内网专线时才用)。
#   留空 = 按 DEEPSEEK_VIA 自动取正确值。⚠️ 单独改它而不改 DEEPSEEK_VIA = key 对不上 = 全量 401。
#   ⚠️ 别抄下面 TTS 段的 DASHSCOPE_BASE_URL(=/api/v1, 那是百炼**原生**接口), 兼容端点是 /compatible-mode/v1。
# DEEPSEEK_BASE_URL=
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型路由默认策略。注意 DEFAULT_EXPENSIVE_MODEL 的代码默认值现在也是 deepseek-chat
#   (贵模型分支已经不走 Claude/OpenAI 了, 见文件末尾"已删除的死变量")。
# DEFAULT_EXPENSIVE_MODEL=deepseek-chat
# DEFAULT_CHEAP_MODEL=deepseek-chat
# MODEL_CIRCUIT_BREAKER_THRESHOLD=5      # 连续失败几次熔断该模型
# AI_FALLBACK_STRATEGY=serial            # serial=依次降级重试 | race=并发抢答(更快更贵)
# AI_REQUEST_TIMEOUT_MS=60000            # 普通 LLM 调用超时
# AI_ARTICLE_TIMEOUT_MS=120000           # 长文生成超时(整篇文章那种)

# TaskType → 具体模型名 的直映射(T2 路由)
# DEEPSEEK_MODEL_CHAT=deepseek-chat
# DEEPSEEK_MODEL_REASONER=deepseek-reasoner
# QWEN_MODEL_PLUS=qwen-plus
# QWEN_MODEL_MAX=qwen-max

# LLM 单价覆盖(JSON, 单位: 分/1M token), 例:
#   LLM_PRICE_OVERRIDES={"deepseek-chat":{"in":200,"out":800}}
# 默认价目硬编码在 services/billing/llm-cost.ts(2026-07 手抄, 以百炼账单为准)。
# 涨价/接新模型时改这个变量即可, 不用改代码重新部署。不配 = 用代码里的默认价目。
# LLM_PRICE_OVERRIDES=


# ══════════════════════════════════════════════════════════════════════════════
# 5. AI 审稿员(内容自动裁决)
# ══════════════════════════════════════════════════════════════════════════════

# off    = 完全关闭
# shadow = **默认**。只把 AI 的采用/驳回建议记进库, 不动内容状态(影子期, 用来攒准确率数据)
# live   = 达到信心阈值后自动裁决(真的改状态)
# ⚠️ 交接提示: 现在是 shadow, 所以"AI 审稿员看起来没起作用"是**预期行为**, 不是 bug。
#    要真启用先看 `pnpm --filter @bossmate/server review:report` 的影子期准确率。
# AI_REVIEWER_MODE=shadow
# AI_REVIEWER_MIN_CONFIDENCE=0.75   # live 模式下自动 approve 的最低置信度, 低于则退回只记建议
# AI_REVIEWER_DAILY_CAP=10          # live 模式每租户每日自动裁决上限(安全阀), 超了退回 shadow 行为


# ══════════════════════════════════════════════════════════════════════════════
# 6. 内容生成质量(公众号图文四件套 / 模板 / 标题)
# ══════════════════════════════════════════════════════════════════════════════
# 下面每个 pass 都能独立关掉; LLM 调用失败一律用原文兜底, 不阻塞出稿。

# ARTICLE_SIXDIM_QC=true            # ①六维质检 + 定向重写闭环
# ARTICLE_QUALITY_REWRITE_MAX=2     # ①质检不过时最多定向重写几轮(0=只打分不重写)
# ARTICLE_HOOK_INJECT=true          # ②生成 prompt 注入钩子模式库
# ARTICLE_DECLICHE=true             # ③AI 腔检测 + 段落级清洗
# ARTICLE_CONDENSE=true             # ④压缩去水分
# ARTICLE_CONDENSE_RATIO=0.72       # ④目标压缩比(压到原文 72%)
# ARTICLE_TEMPLATE_ROTATION=true    # 排版模板轮换: true=4 套模板随机, false=固定默认 shunshi
# QUALITY_MIN_SCORE=70              # 内容质量分下限, 低于此分不进入分发


# ══════════════════════════════════════════════════════════════════════════════
# 7. 草稿箱分发 / 每日生成配额
# ══════════════════════════════════════════════════════════════════════════════
# 语义: DRAFT_TARGET_PER_ACCOUNT(每号每日下限) ≤ DRAFT_PUSH_PER_ACCOUNT(每号每日上限)

# DRAFT_TARGET_PER_ACCOUNT=2   # 保底: 分发跑两轮把每个号填到这个数
# DRAFT_PUSH_PER_ACCOUNT=2     # 天花板: 每号每日最多推几篇进公众号草稿箱
# DRAFT_GEN_BUFFER=1.3         # 生成缓冲乘数: 按"号数×下限×本值"提量, 留出配不上/冷却枯竭/质检剔除的损耗
# DAILY_GEN_HARD_CAP=40        # 每日生成总篇数硬上限, 防号一多 LLM 调用失控烧钱
# DRAFT_PUSH_CRON_HOUR=8       # 每日几点(北京时间)推草稿
# WECHAT_STATS_CRON_HOUR=9     # 每日几点(北京时间)拉"昨日"公众号阅读数据(getarticlesummary 是 T+1)


# ══════════════════════════════════════════════════════════════════════════════
# 8. 期刊数据源 / 富化
# ══════════════════════════════════════════════════════════════════════════════

# ┌──────────────────────────────────────────────────────────────────────────┐
# │ ⚠️ 合规红线 —— CNKI_SCRAPE_ENABLED                                        │
# └──────────────────────────────────────────────────────────────────────────┘
# 知网(CNKI)抓取总开关, **默认 false, 是 7-20 拍板的合规熔断, 故意关闭的**。
# 背景: journal-content-collector 的国内刊分支曾会调 scrapeCnkiJournal 打 navi.cnki.net,
#       但库里零知网数据痕迹(field_provenance/metadata/source_url/data_source 全 0),
#       失败只打 logger.debug(线上 LOG_LEVEL=info 根本看不见) → 静默发请求、什么也拿不到。
# ⚠️⚠️ **不要为了补数据打开它。** 生产 .env 不配置此项 = 永久关闭 = 正确状态。
#      需要国内刊数据请走万方(wanfangdata)/LetPub/北大核心/CSCD 这些允许的源。
# CNKI_SCRAPE_ENABLED=false

# Springer Nature API(免费申请: https://dev.springernature.com)
SPRINGER_API_KEY=your-springer-api-key
# SPRINGER_PROXY=http://127.0.0.1:7890    # 需翻墙访问 link.springer.com 时填本地代理

# OpenAlex polite-pool 邮箱。配了请求会带 ?mailto=<email>, 享 10K req/day 免费额度;
# 不配走 anonymous pool(额度低很多, 高峰期容易被限)。必须是合法邮箱格式, 否则 env 校验不过。
# OPENALEX_MAILTO=you@example.com


# ══════════════════════════════════════════════════════════════════════════════
# 9. 微信公众号 / 小程序
# ══════════════════════════════════════════════════════════════════════════════

# 公众号入站 webhook 校验 token(公众号后台「开发 - 基本配置」里那个 Token)。
# ⚠️ 生产环境若仍是仓库默认值 ai_butler_token_2026, 服务启动直接 exit(1) —— 这是故意的:
#    用仓库里公开的默认值 = 任何看过源码的人都能伪造公众号回调签名。交接时换成随机串。
WECHAT_VERIFY_TOKEN=换成一串随机值

# 期刊检索小程序登录(wx.login + getPhoneNumber)。小程序后台 → 开发管理 → 开发设置。
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=


# ══════════════════════════════════════════════════════════════════════════════
# 10. 企业微信 / AI 客服
# ══════════════════════════════════════════════════════════════════════════════

# 企微自建应用 + 微信客服回调(企微管理后台取)
WECHAT_WORK_CORP_ID=
WECHAT_WORK_SECRET=
WECHAT_WORK_TOKEN=
WECHAT_WORK_AES_KEY=

# 微信客服「接待链接」(kf/add_contact_way 生成, 或客服控制台里取)。
# 用于公众号欢迎语/被动回复里给客户一个真人客服入口。留空 = 文案里不含客服链接(不报错)。
# WECOM_KF_URL=
# 上面那个接待链接的二维码 PNG(OSS 公网 URL, 用 scripts/upload-kf-qr.mjs 生成并上传)。
# 混剪视频片尾 outro 会叠这张图。留空 = 片尾不叠二维码。
# WECOM_KF_QR_URL=

# 客服自助化护栏
# KF_FAQ_IMPORT_MAX=200              # FAQ 批量导入单次条数上限(防误粘超大文本)
# KF_SUGGEST_MAX_CONVERSATIONS=30    # 「从历史对话生成 FAQ 建议」单次扫描会话数上限(每次一趟 LLM, 成本护栏)

# ⚠️ 敏感词硬闸的词库是**文件**不是环境变量:
#    packages/server/src/services/work-wechat/sensitive-lexicon.txt
#    该文件缺失 = 硬闸 fail-open(静默放行), 线上只留一行 error 日志。
#    build 已加 scripts/copy-assets.mjs 把它拷进 dist, 部署时别把它漏了。


# ══════════════════════════════════════════════════════════════════════════════
# 11. 抖音开放平台 / 发布节奏
# ══════════════════════════════════════════════════════════════════════════════

# 官方 OAuth 代发(scope video.create.bind)。一个 BossMate 企业应用服务所有租户;
# 账号级 credentials.clientKey/clientSecret 可覆盖这里的全局值。
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
# OAuth 回调地址, 必须与开放平台控制台里配的完全一致
# DOUYIN_OAUTH_REDIRECT_URL=https://<your-domain>/api/v1/douyin/oauth/callback
# create_video 默认可见范围: 0=公开 1=仅自己可见(草稿模式, 人工在 App 里再改公开) 2=好友可见
# DOUYIN_PRIVATE_STATUS=1


# ══════════════════════════════════════════════════════════════════════════════
# 12. 阿里云(AccessKey / OSS / 短信 / 内容安全)
# ══════════════════════════════════════════════════════════════════════════════

# ⚠️ 阿里云 AccessKey 在本项目里有**两套并存的命名**, 是历史遗留:
#      ALIYUN_ACCESS_KEY_ID / ALIYUN_ACCESS_KEY_SECRET  ← 数字人 DVH、图片审核、短信 走这套
#      ALIYUN_AK_ID         / ALIYUN_AK_SECRET          ← TTS(阿里云 NLS) 历史用这套
#    代码里已做跨兜底(`env.ALIYUN_ACCESS_KEY_ID || env.ALIYUN_AK_ID`), **配任意一对即可**。
#    建议: 只填 ALIYUN_ACCESS_KEY_ID/SECRET 这一对, 另一对留空, 免得两处不同步埋雷。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# ALIYUN_AK_ID=
# ALIYUN_AK_SECRET=

# 对象存储 OSS(媒体文件已全量切到阿里云 OSS)。
# ⚠️ bucket 需**公共读**: 抖音/公众号等平台要能直接拉到媒体 URL。
# ⚠️ 切换前先跑 `pnpm --filter @bossmate/server oss:check` 验证连通与读写权限。
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET=bossmate-media
OSS_ACCESS_KEY=
OSS_SECRET_KEY=

# 阿里云短信(可选; 用于登录验证码 + 新客户开通欢迎短信)。
# ⚠️ 运行时直读 process.env, 不在 env.ts schema 里 —— 配错不会在启动时报错, 而是发短信那一刻抛
#    SMS_NOT_CONFIGURED。SMS_PROVIDER 不填 = 开发模式: 验证码只打进日志、不真发。
# ⚠️ 还需要额外装 SDK: pnpm add @alicloud/dysmsapi20170525(代码里是动态 import, 没装只在调用时报错)
# SMS_PROVIDER=aliyun
# SMS_SIGN_NAME=你的短信签名
# SMS_TEMPLATE_CODE=SMS_xxxxxxxx            # 登录验证码模板
# SMS_WELCOME_TEMPLATE_CODE=SMS_xxxxxxxx    # 新客户开通欢迎短信模板

# 图片内容审核(阿里云内容安全 ImageModeration/baselineCheck), 复用上面的 ALIYUN_ACCESS_KEY_*。
# IMAGE_MODERATION_ENABLED=true
# IMAGE_MODERATION_STRICT=false             # 审核接口本身挂了怎么办: false=放行(不因审核抖动断更) true=拦截
# IMAGE_MODERATION_ENDPOINT=green-cloud.cn-shanghai.aliyuncs.com   # cn-shanghai|cn-beijing|cn-hangzhou
# IMAGE_MODERATION_BLOCK_SCORE=90           # confidence ≥ 此值 → 拦截
# IMAGE_MODERATION_REVIEW_SCORE=60          # confidence ≥ 此值 → 警告但放行
# IMAGE_MODERATION_CONCURRENCY=10           # 批量审核并发上限
# IMAGE_MODERATION_MAX_IMAGES=20            # 单条内容最多审几张(封面 + 正文内嵌)
# IMAGE_MODERATION_TIMEOUT_MS=8000          # 单图审核读/连超时


# ══════════════════════════════════════════════════════════════════════════════
# 13. TTS 配音 / 声音克隆
# ══════════════════════════════════════════════════════════════════════════════

# aliyun      = 阿里云 NLS(需 ALIYUN_AK_* + ALIYUN_NLS_APPKEY, 或 TTS_API_KEY 静态 token + APPKEY)
# dashscope   = 阿里云百炼 qwen-tts(**复用 QWEN_API_KEY**, 跟 LLM 同一个阿里云账号, 好核算成本)
# siliconflow = SiliconFlow 托管 CosyVoice2
# azure       = Azure 语音(需 TTS_API_KEY + AZURE_SPEECH_REGION)
# TTS_PROVIDER=aliyun
# TTS_API_KEY=                              # aliyun 静态 token / azure key
# ALIYUN_NLS_APPKEY=                        # 阿里云 NLS 应用 appkey
# TTS_VOICE_ID=siqi                         # 阿里云 NLS 音色。siqi(商业默认,亲和女声)/ruoxi/zhibei_emo/aiyue
#                                           #   历史默认是 xiaoyun(早期童音, 机械感重), 别调回去
# TTS_SPEED=1.15                            # 合成后用 ffmpeg atempo 变速(保音调), 通吃所有 provider。科普类建议 1.15~1.25
# AZURE_SPEECH_REGION=

# SiliconFlow CosyVoice2(OpenAI 兼容 /audio/speech)
# SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# TTS_SILICONFLOW_MODEL=FunAudioLLM/CosyVoice2-0.5B
# TTS_SILICONFLOW_VOICE=FunAudioLLM/CosyVoice2-0.5B:diana   # alex/benjamin/charles/david(男) anna/bella/claire/diana(女)
# TTS_SILICONFLOW_SPEED=1

# 阿里云百炼 qwen-tts
# TTS_DASHSCOPE_MODEL=qwen-tts
# TTS_DASHSCOPE_VOICE=Cherry                # Cherry(女,活泼)/Serena(女,沉稳)/Ethan(男)/Chelsie …

# 声音克隆(运行时直读 process.env, 不在 schema 里)
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# QWEN_VC_MODEL=qwen3-tts-vc-2026-01-22     # 克隆音色的模型名
# QWEN_TTS_CLONE_VOICE=                     # 全局默认克隆音色 id; 一般留空, 按账号在库里配


# ══════════════════════════════════════════════════════════════════════════════
# 14. 数字人 DVH(阿里云虚拟数字人) / 字幕
# ══════════════════════════════════════════════════════════════════════════════

# DVH 凭证。DVH_REAL_MODE=true 但 TENANT_ID/APP_ID 缺失 → 生成接口直接报错(不会静默走假数据)。
# 合成计费约 0.165 元/秒(5 月实测), 90 秒视频 ≈ 250-350 字脚本。
# DVH_TENANT_ID=
# DVH_APP_ID=
# DVH_REAL_MODE=false                       # false=走 mock 样片(不扣费), 生产要 true
# DVH_DEFAULT_BG_URL=                       # 默认背景图(公网 URL)
# DVH_MOCK_FIXTURE_BASE=                    # mock 模式的兜底样片 base URL; 空=用 OSS 占位桶
#                                           #   (曾经写死 example.com 死链, 用户拿到打不开的视频)

# DVH 音频驱动模式(运行时直读 process.env)
# DVH_AUDIO_DRIVEN=0                        # 1=用我们自己合成的音频驱动数字人口型
# DVH_AUDIO_SAMPLE_RATE=                    # 音频采样率, 不填用 SDK 默认
# DVH_AVATAR_MODEL_TYPE=2D                  # 形象模型类型
# DVH_PUBLIC_BASE=                          # ⚠️ 开 DVH_AUDIO_DRIVEN 时必填: 音频/字幕要公网可达。
#                                           #   本地存储返回的是相对路径, 没这个前缀会在 submit 前抛错
#                                           #   (故意在提交前抛 —— 提交不可达资源 = 白扣费 + 孤儿任务)
# DVH_BGM_DIR=                              # 混剪 BGM 目录, 不填回退 BGM_DIR
# DVH_REMIX_FONT=                           # 混剪片头/片尾字体文件路径

# 字幕 + 语速。改完重启 pm2 即生效, 不用改代码重新构建; **只影响新生成的视频**。
# DVH_SPEECH_RATE=50                        # 阿里云 -500~500, 0=1.0x, 50≈1.1x
# DVH_SUBTITLE_FONT_NAME=Noto Sans CJK SC
# DVH_SUBTITLE_FONT_SIZE=15                 # ⚠️ 288 坐标系: 实际像素 = 值/288×视频高。
#                                           #   15 ≈ 100px ≈ 抖音正常字幕(11 字/行);
#                                           #   36 在 1080×1920 上 = 240px/字, 4.5 个字占满屏宽(曾实锤溢出)。
#                                           #   调之前先算像素账, 别肉眼盲调。
# DVH_SUBTITLE_MARGIN_V=84                  # 距底 84/288≈29%, 避开抖音底部 UI 又不压人脸。200 曾 =69%(快到画面中间)
# DVH_SUBTITLE_ALIGNMENT=2                  # 1-9 九宫格, 2=居中下方, 8=居中上方
# DVH_SUBTITLE_BOLD=1                       # 0/1
# DVH_SUBTITLE_OUTLINE=2                    # 描边宽度
# DVH_SUBTITLE_PRIMARY_COLOUR=&H00FFFFFF&   # 字色, ASS 格式 &HAABBGGRR&(白)
# DVH_SUBTITLE_OUTLINE_COLOUR=&H00000000&   # 描边色(黑)
# DVH_SUBTITLE_EMPHASIS=true                # 关键词强调(数字/分区/IF 等黄色加粗放大 1.35 倍)。false = 回老的 force_style 路径
# DVH_SUBTITLE_EMPHASIS_MAX=2               # 每条字幕最多强调几处(防满屏黄字); 0=不限

# DVH 后处理护栏
# DVH_FFMPEG_TIMEOUT_MS=300000              # ffmpeg 超时(5min), 超时 SIGKILL 防卡死
# DVH_DOWNLOAD_TIMEOUT_MS=60000             # 下载 mp4/srt 超时
# DVH_DOWNLOAD_MAX_MB=600                   # 下载体积上限


# ══════════════════════════════════════════════════════════════════════════════
# 15. 视频合成 / BGM / 素材
# ══════════════════════════════════════════════════════════════════════════════

# VIDEO_RESOLUTION=1080x1920
# VIDEO_WORKER_CONCURRENCY=1                # 全局视频 worker 并发
# VIDEO_TENANT_MAX_CONCURRENT=2             # 单租户同时最多几个合成任务
# VIDEO_MAX_IMAGES=15
# VIDEO_MAX_DURATION_SEC=120
# VIDEO_FONT_PATH=                          # 字幕字体文件绝对路径, 不填用系统字体
# FFMPEG_PATH=ffmpeg                        # 不在 PATH 里就写绝对路径
# FFPROBE_PATH=ffprobe

# BGM。⚠️ 生产建议写**绝对路径**(如 /home/projects/bossmate/data/bgm/default.mp3):
#   pm2 的 cwd = packages/server, 相对路径会解析到错的位置。composer.ts 有 fallback 链兜底, 但别依赖它。
# BGM_DEFAULT_PATH=data/bgm/default.mp3
# BGM_DIR=data/bgm                          # 曲库目录: 放多个 .mp3, 每条视频随机选一首(不同号听感不同)

# Pexels 图库(运行时是 opt-in, 默认关闭)
# PEXELS_API_KEY=
# VIDEO_ENABLE_STOCK_PHOTOS=0               # 1=允许用 Pexels 素材图(运行时直读)
# VIDEO_KENBURNS=1                          # 0=关掉 Ken Burns 缓推镜头(运行时直读)



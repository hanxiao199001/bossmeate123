# 16. 功能总开关
# ══════════════════════════════════════════════════════════════════════════════

# USE_CEO_AGENT=false            # true=走 CEO Agent + EventBus 新链路, false=走旧 Orchestrator
# V3_BATCH_AGENT_ENABLED=false   # V3 批处理 agent 总开关(orchestrator/knowledge-engine/content-director 三个定时调度看它)
# SALES_AGENT_ENABLED=false      # AI 销售对话模块(后端)
# SALES_AUTO_FOLLOWUP=true       # 销售自动跟进


# ══════════════════════════════════════════════════════════════════════════════
# 17. 运行时直读的开关(**不在 env.ts schema 里**)
# ══════════════════════════════════════════════════════════════════════════════
# ⚠️ 这一组是代码里直接 `process.env.XXX` 读的, 没有进 zod schema。后果:
#      - 拼错变量名**不会**在启动时报错, 只会静默用默认值;
#      - 启动日志里也看不到它们的当前值。
#    改这里的任何一项后, 建议手动确认一次真的生效了。全部非必填。

# ── 期刊爬取 / 富化的熔断与限速 ──────────────────────────────────────────────
# ⚠️ 爬取节奏铁律: **列表爬与 enrich 绝不同时跑**, 否则容易触发对方反爬把 IP 拉黑。
# ENRICH_SKIP_LETPUB=false        # true=富化时跳过 LetPub(它反爬时的熔断开关)
#
# ⚠️⚠️ ENRICH_WRITEBACK_ENABLED —— **默认 false, 现在不要打开** ⚠️⚠️
#   作用: 生成时 enrichment 抓到的 IF/分区/中科院分区/录用率/审稿周期回写 journals 表
#         (backlog-C 治本: 让"喂给 LLM 的数据"和"事后三道防编造闸读的 DB"变成同一份)。
#   历史(2026-07-25 事故): 这个功能 7-25 刚做完就试启用, 当天发现**上游 LetPub 页面已改版**,
#         journal_scraper.py 的选择器全部错位 —— 抓回来的是 impactFactor=2026(页面上的年份)、
#         name="按研究方向查看:"(侧边导航文案)。而回写会把这些假值**永久钉进 DB**, 于是三道
#         防编造闸(正文/标题/六维评分)全部失效 —— 它们都以 DB 为唯一真相源, DB 和提示词
#         "一致地错", 校验器反过来给假数据背书。已产出一篇《2026 逆天影响因子》。
#         污染已回滚, scrapling 已卸载, 功能改为"代码在但不启用"。
#   打开的前置条件(缺一不可):
#     1) 重写 packages/server/scripts/journal_scraper.py 的 LetPub 选择器并用真实期刊验证;
#     2) 确认 validateTrustedFacts(services/crawler/trusted-facts-validator.ts)能拦住异常值 ——
#        跑 `npx vitest run src/__tests__/trusted-facts-guardrail.test.ts`;
#     3) 先只开一天, 看 ops_incidents 里 enrich_writeback_rejected 这类事件是否为 0。
# ENRICH_WRITEBACK_ENABLED=false
# LETPUB_PROXY=                   # LetPub 走代理, 如 http://127.0.0.1:7890
# ENRICH_SKIP_WANFANG=false       # true=富化时跳过万方
# BACKFILL_SKIP_WANFANG=false     # true=ISSN 回填脚本跳过万方(与上者任一为 true 即熔断)
# WANFANG_SEARCH_BASE=https://med.wanfangdata.com.cn/Periodical/Search
# JOURNAL_REVERIFY_DAILY_LIMIT=100   # 每日期刊复核条数上限
# JOURNAL_REVERIFY_FORCE_ALL=false   # true=无视 confidence 全量复核(补数据时临时开, 别常开)
# JOURNAL_REUSE_COOLDOWN_DAYS=15     # 同一本刊多少天内不重复选(防全账号撞车)
# JOURNAL_TOPIC_POOL_CAP=1500        # journal_mining 选题池上限, 防无上限增长

# ── Jina 网页抓取(期刊官网正文提取的兜底通道) ─────────────────────────────────
# JINA_FETCH_ENABLED=true         # 设成字符串 "false" 才会关
# JINA_API_KEY=                   # 不填走匿名额度(更容易被限)
# JINA_FETCH_TIMEOUT_MS=25000

# ── 发布节奏(抖音风控: 一秒批量齐发 = 机器行为, 会触发短信墙甚至关联封号) ────────
# 这是"让发布行为本身真的低风险"的做法: 不伪造任何信号、不绕过任何检测, 只是放慢+打散+拟人。
# DY_PACE_MIN_MS=360000           # 抖音/视频号两次派单最小随机间隔(默认 6 分钟)
# DY_PACE_MAX_MS=1080000          # 最大随机间隔(默认 18 分钟)
# DY_PACE_ACCOUNT_MIN_MS=5400000  # 同一个号两条之间最小间隔(默认 90 分钟, 防同号连发)
# DY_PACE_MAX_SPREAD_MS=14400000  # 整批打散窗口上限(默认 4 小时, 防拖到天荒地老)
# DY_PACE_START_JITTER_MS=60000   # 起始随机偏移上限(默认 0~60 秒, 别整点齐发)
# PUBLISH_SERVER_THROTTLE_MS=3000 # 公众号等服务器凭证平台的小节流(不涉及上面那道风控)

# ── 其它 ────────────────────────────────────────────────────────────────────
# TITLE_GEN_ENABLED=1             # ⚠️ 反直觉: 判断写的是 `!== "0"`, 所以**只有填字符串 "0" 才关**, 填 false 也还是开着
# HOOK_PATTERNS_LEARNED_PATH=     # 学习到的标题钩子模式 JSON 落盘路径, 不填用默认位置
# ENV_FILE_PATH=                  # 覆盖 .env 的查找路径(绝对路径)。不填 = monorepo 根 /.env; 指向的文件不存在会直接 throw


# ══════════════════════════════════════════════════════════════════════════════
# 18. 只给一次性脚本用的变量(平时不用配)
# ══════════════════════════════════════════════════════════════════════════════
# 这些不用写进 .env, 用的时候在命令行前面临时带上就行, 例:
#   HANXIAO_TENANT_ID=xxx pnpm --filter @bossmate/server tsx src/scripts/seed-hanxiao-accounts.ts
